# Production Dockerfile - nginx + php-fpm with React frontend
FROM php:8.4-fpm-alpine3.20 AS base

ARG UID=1000
ARG GID=1000

# Install system dependencies and PHP extensions
RUN apk add --no-cache \
    git \
    unzip \
    supervisor \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    oniguruma-dev \
    linux-headers \
    $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
    pdo_mysql \
    zip \
    gd \
    mbstring \
    bcmath \
    opcache \
    pcntl \
    && apk del $PHPIZE_DEPS

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Create laravel user (for file ownership)
RUN addgroup -g ${GID} -S laravel \
    && adduser -u ${UID} -S laravel -G laravel

WORKDIR /var/www/html

# =============================================================================
# DEPENDENCY INSTALLATION (cached layer)
# =============================================================================
COPY --chown=laravel:laravel backend/composer.json backend/composer.lock* ./

RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts \
    && rm -rf /home/laravel/.composer/cache

# =============================================================================
# APPLICATION CODE
# =============================================================================
COPY --chown=laravel:laravel backend/. .

RUN composer dump-autoload --optimize \
    && php artisan package:discover --ansi

# =============================================================================
# STORAGE & CACHE PERMISSIONS
# =============================================================================
RUN mkdir -p storage/framework/{cache,sessions,views,testing} \
    bootstrap/cache \
    && chown -R laravel:laravel storage bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache

# =============================================================================
# OPcache configuration for production
# =============================================================================
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# =============================================================================
# Copy configuration files
# =============================================================================
COPY docker/supervisor/supervisord.conf.production /etc/supervisor/conf.d/supervisord.conf
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d /etc/nginx/conf.d

# Create log directory
RUN mkdir -p /var/log /var/cache/nginx /var/log/nginx /run/nginx

# =============================================================================
# Install nginx in final stage
# =============================================================================
RUN apk add --no-cache nginx

# Copy React frontend build (after nginx install to avoid overwrite)
COPY frontend-dist /usr/share/nginx/html
COPY frontend-dist /var/www/html/public

# Expose ports
EXPOSE 8000 8083

# Healthcheck - check both HTTP and WebSocket
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8000/up || exit 1

# Run as root (supervisor manages processes)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]