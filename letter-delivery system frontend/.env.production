# Frontend Production Environment Template
# Copy this file to .env.production and fill in all required values
# Build command: docker compose -f docker-compose.frontend.yml build
# Or locally: npm run build (will use this file if renamed to .env.production)

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Full URL to the Laravel backend API (must be accessible from browser)
# Example: https://api.your-domain.example.com
VITE_API_BASE_URL=https://your-domain.example.com

# =============================================================================
# WEBSOCKET / REVERB CONFIGURATION
# =============================================================================
# WebSocket URL for Laravel Reverb (must be accessible from browser)
# Use wss:// for HTTPS, ws:// for HTTP
# Example: wss://your-domain.example.com:8083
VITE_WS_URL=wss://your-domain.example.com:8083

# Reverb configuration (matching backend)
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=your-domain.example.com
VITE_REVERB_PORT=8083
VITE_REVERB_SCHEME=https