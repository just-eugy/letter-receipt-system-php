APP_NAME="Letter Receipt System (PHP)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_TIMEZONE=Africa/Accra
APP_ORGANIZATION_NAME=GCX
APP_PORT=8082

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=letter_receipt_php
DB_USERNAME=laravel
DB_PASSWORD=

DB_ROOT_PASSWORD=

APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_ENCRYPT=true

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,127.0.0.1:8082,::1

APP_RATE_LIMIT_ENABLED=true

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=secret
REVERB_HOST=localhost
REVERB_PORT=8083
REVERB_SCHEME=http

UID=1000
GID=1000