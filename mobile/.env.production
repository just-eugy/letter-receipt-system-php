# Mobile App Production Environment Template
# Copy this file to .env.local and fill in all required values
# Restart with: npx expo start --clear after changing

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Full URL to the Laravel backend API (must be reachable FROM THE DEVICE)
# 
# For physical devices on the same network:
#   http://<server-lan-ip>:8082 (HTTP) or https://your-domain.example.com (HTTPS)
#
# For Android emulator:
#   http://10.0.2.2:8082 (HTTP) - 10.0.2.2 is the host machine's loopback
#
# For iOS simulator:
#   http://localhost:8082 (HTTP) - or use your Mac's LAN IP
#
# IMPORTANT: The device/simulator must be able to reach this URL!
# Test with: curl http://<your-api-url>/api/public/recipient-roles

EXPO_PUBLIC_API_URL=https://your-domain.example.com